APP_NAME=ChainGuard
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DEMO_MODE=false
DATABASE_URL=sqlite:///./chainguard.db
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
EVENT_PROVIDER=demo
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider settings are intentionally modular and must be supplied via environment variables when enabled.
# Example:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_key_here
