APP_NAME=ChainGuard
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
DEMO_MODE=false

# Blockchain provider: "demo" or "real"
BLOCKCHAIN_PROVIDER=demo
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=
# BLOCKCHAIN_API_TIMEOUT=30
# BLOCKCHAIN_PAGE_SIZE=200
# BLOCKCHAIN_MAX_PAGES=1

DATABASE_URL=sqlite:///./chainguard.db

# ---------------------------------------------------------------------------
# AI Investigation (optional — deterministic analysis works without AI)
# ---------------------------------------------------------------------------
# Controlling variables (backend/.env):
#   AI_PROVIDER   -> none | gemini | openai | ollama | openai-compatible
#   AI_API_KEY    -> required for gemini (Google AI Studio) and openai
#   AI_MODEL      -> gemini default gemini-2.5-flash; openai default gpt-4o-mini;
#                    ollama default llama3.2
#   AI_BASE_URL   -> gemini default https://generativelanguage.googleapis.com/v1beta/openai
#                    openai default https://api.openai.com/v1
#                    ollama default http://127.0.0.1:11434/v1
#   AI_TIMEOUT    -> seconds (default 60)
#
# Gemini (Google AI Studio) example:
#   AI_PROVIDER=gemini
#   AI_API_KEY=
#   AI_MODEL=gemini-2.5-flash
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_TIMEOUT=60
#
# OpenAI example:
#   AI_PROVIDER=openai
#   AI_API_KEY=
#   AI_MODEL=gpt-4o-mini
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_TIMEOUT=60
#
# Local Ollama example (no API key required):
#   AI_PROVIDER=ollama
#   AI_MODEL=llama3.2
#   AI_BASE_URL=http://127.0.0.1:11434/v1
#   AI_TIMEOUT=90
#
# After changing these values, restart uvicorn so settings reload.
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT=60

EVENT_PROVIDER=demo
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chaingaurd.vercel.app
