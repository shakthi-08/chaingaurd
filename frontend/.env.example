# Set these in Vercel Project Settings for a deployed frontend.
# Do not include a trailing slash.
# VITE_API_BASE=https://your-backend.onrender.com
# VITE_WS_BASE=wss://your-backend.onrender.com

# Leave both unset for local Vite proxy to http://127.0.0.1:8000
# Real mode does not stream live WebSocket events.